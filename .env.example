# Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Replace USERNAME, PASSWORD, and CLUSTER with your MongoDB Atlas details
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/golden_packers?retryWrites=true&w=majority

# Local MongoDB Fallback (Alternative for local development without Atlas)
# MONGODB_URI=mongodb://127.0.0.1:27017/golden_packers

# Security & JWT Authentication
JWT_SECRET=golden_packers_movers_super_secret_jwt_key_2026_change_this_in_production
JWT_EXPIRES_IN=7d

# Initial Admin Credentials (Seeded into MongoDB on server startup)
ADMIN_EMAIL=admin@goldenpackers.com
ADMIN_PASSWORD=GoldenPackers@2026
ADMIN_NAME=Golden Admin

# File Upload Configuration
MAX_FILE_SIZE_MB=5
UPLOAD_PATH=uploads
